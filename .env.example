# انسخ الملف ده باسم .env (ومتترفعوش على GitHub - .gitignore بيمنعه) واملأ القيم
# من Supabase Dashboard -> Project Settings -> API.
# استخدم مفتاح "anon / public" بس - مفتاح service_role ممنوع تحطه هنا أبدًا
# (ده بيتشحن في الـ frontend ويبان لأي حد).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
